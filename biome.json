{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "packages/**/*.{ts,js,mjs,json}",
      "apps/**/*.{ts,js,mjs,json}",
      "infra/**/*.{ts,js,mjs,json}",
      "sim/**/*.{ts,js,mjs,json}",
      "scripts/**/*.{ts,js,mjs,json}",
      "biome.json",
      "package.json",
      "tsconfig*.json",
      "vitest.config.ts",
      "!!**/node_modules",
      "!!**/cdk.out"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error",
        "useImportExtensions": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "resend": "Only packages/resend-client (and packages/ingest, for webhooks.verify) may import resend (ADR-009, ADR-012)."
            },
            "patterns": [
              {
                "group": ["@aws-sdk/*", "@aws-sdk/**"],
                "message": "Only packages/aws may import @aws-sdk/* (ADR-013)."
              },
              {
                "group": ["@ledger/*/**", "!@ledger/*/testing"],
                "message": "Import a workspace package by its name only; the one allowed subpath is /testing."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**", "packages/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@aws-*/**",
                      "@aws/**",
                      "@smithy/**",
                      "aws-*",
                      "aws-*/**",
                      "aws4*",
                      "aws4*/**",
                      "amazon-*",
                      "amazon-*/**"
                    ],
                    "message": "packages/core and packages/shared import nothing from AWS (ADR-013)."
                  },
                  {
                    "group": [
                      "pg",
                      "pg/**",
                      "pg-*",
                      "pg-*/**",
                      "postgres",
                      "postgres/**",
                      "postgres-*",
                      "postgres-*/**",
                      "drizzle-*",
                      "drizzle-*/**",
                      "@neondatabase/**",
                      "@vercel/postgres",
                      "@vercel/postgres/**",
                      "@electric-sql/pglite",
                      "@electric-sql/pglite/**",
                      "@databases/pg",
                      "@databases/pg/**",
                      "@testcontainers/postgresql",
                      "@testcontainers/postgresql/**",
                      "@supabase/**",
                      "prisma",
                      "prisma/**",
                      "@prisma/**",
                      "kysely",
                      "kysely/**",
                      "knex",
                      "knex/**",
                      "slonik",
                      "slonik/**",
                      "sequelize",
                      "sequelize/**",
                      "typeorm",
                      "typeorm/**",
                      "@mikro-orm/**"
                    ],
                    "message": "packages/core and packages/shared import nothing from Postgres (ADR-013)."
                  },
                  {
                    "group": [
                      "resend",
                      "resend/**",
                      "@resend/**",
                      "react-email",
                      "react-email/**",
                      "@react-email/**"
                    ],
                    "message": "packages/core and packages/shared import nothing from Resend (ADR-013)."
                  },
                  {
                    "group": ["@ledger/*/**", "!@ledger/*/testing"],
                    "message": "Import a workspace package by its name only; the one allowed subpath is /testing."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/aws/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "resend": "Only packages/resend-client (and packages/ingest, for webhooks.verify) may import resend (ADR-009, ADR-012)."
                },
                "patterns": [
                  {
                    "group": ["@ledger/*/**", "!@ledger/*/testing"],
                    "message": "Import a workspace package by its name only; the one allowed subpath is /testing."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/resend-client/**", "packages/ingest/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@aws-sdk/*", "@aws-sdk/**"],
                    "message": "Only packages/aws may import @aws-sdk/* (ADR-013)."
                  },
                  {
                    "group": ["@ledger/*/**", "!@ledger/*/testing"],
                    "message": "Import a workspace package by its name only; the one allowed subpath is /testing."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
