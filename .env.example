# Ledger's public environment variables (.ai/api-contract.md → Conventions). Names only, never
# values: this file is committed.
#
# Copy it to .env.local (git-ignored) and fill in what you need. Local entry points load it with
# `node --env-file-if-exists=.env.local`; a variable already set in the shell wins over the file.

# Read API base URL, read by the CLI, the SDK client, the MCP server and `pnpm sim`; written
# locally by pnpm db:setup (slice 1).
LEDGER_URL=
# Required by the CLI; locally pnpm db:setup writes a placeholder, which works while the loopback server skips auth (slice 1); enforced from slice 2.
LEDGER_TOKEN=
# Simulator signing secret: written locally by pnpm db:setup; for a deployed stack, the stack's simulator secret (ADR-016, slice 3).
LEDGER_SIMULATOR_SECRET=
# Resend API key, read by the Resend CLI (slice 1) and packages/resend-client (slice 4).
RESEND_API_KEY=
# Postgres connection string, read by apps/local, the migrations and `pnpm sim` (slice 1).
# The compose Postgres (`pnpm db:up`) listens on 127.0.0.1:55432.
DATABASE_URL=
# Address-hash key, 64 hex characters; written once by pnpm db:setup, never changed (data-modeling.md → PII & retention).
LEDGER_ADDRESS_HASH_KEY=
# Local Resend signing secrets, comma-separated whsec_ values; one per resend webhooks listen session (RS-U22).
LEDGER_WEBHOOK_SECRETS=
# AWS region, read by the CDK deploy and the AWS scripts in infra/ (slice 2).
AWS_REGION=
# AWS CLI profile, read by the CDK deploy and the AWS scripts in infra/ (slice 2; local only).
AWS_PROFILE=
